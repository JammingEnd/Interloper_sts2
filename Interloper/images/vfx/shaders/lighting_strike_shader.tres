render_mode blend_add, unshaded;

uniform vec2 speed;
uniform sampler2D Texture2DParameter : source_color, hint_default_transparent, repeat_enable;



void fragment() {
// Input:9
	vec4 n_out9p0 = COLOR;


// Input:5
	float n_out5p0 = TIME;


// Vector2Parameter:7
	vec2 n_out7p0 = speed;


// VectorOp:6
	vec2 n_out6p0 = vec2(n_out5p0) * n_out7p0;


// UVFunc:4
	vec2 n_in4p1 = vec2(1.00000, 0.00000);
	vec2 n_out4p0 = n_out6p0 * n_in4p1 + UV;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Texture2DParameter, n_out4p0);
	float n_out3p1 = n_out3p0.r;


// VectorOp:8
	vec3 n_out8p0 = vec3(n_out9p0.xyz) * vec3(n_out3p1);


// Output:0
	COLOR.rgb = n_out8p0;


}
"
